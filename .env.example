# Run python3 scripts/configure.py to generate .env with unique secrets.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PROCESSOR_PASSWORD=replace-with-a-different-long-password
QUERY_PASSWORD=replace-with-another-long-password
# Linux host networking preserves real client addresses and neighbor visibility.
HONEYPOT_HOST=0.0.0.0
RAW_PORT=9000
SSH_OPEN_PORT=2222
SSH_PASSWORD_PORT=2223
WEB_PORT=8080
API_HOST=127.0.0.1
API_PORT=9100
API_URL=http://127.0.0.1:9100
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DATA_DIR=./data
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_IMAGE=lan-telemetry-sandbox:local
SANDBOX_NAME=lan-telemetry-sandbox
MAX_CONNECTIONS=128
MAX_SESSION_BYTES=67108864
SESSION_SECONDS=1800
IDLE_SECONDS=120
MIN_FREE_BYTES=268435456
HEALTH_INTERVAL_SECONDS=30
# Set true when serving the dashboard through HTTPS.
COOKIE_SECURE=false

# Alerttray email notifications. Use a notification API key (X-API-Key), not a login/session token.
ALERTTRAY_ACCESS_TOKEN=
ALERTTRAY_API_URL=https://alerttray.com
# The reference API always adds APNS to registered devices. Set true only for an account with NO registered iPhones.
ALERTTRAY_EMAIL_ONLY_ACCOUNT=false
# Empty sends to the account's alert email; otherwise use this recipient override.
ALERTTRAY_EMAIL=
# New connections are summarized at most once per interval (up to 10 samples per email).
ALERTTRAY_BATCH_SECONDS=60
# Optional LAN dashboard URL included in the email.
ALERTTRAY_DASHBOARD_URL=
